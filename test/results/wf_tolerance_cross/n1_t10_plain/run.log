store size =1Kb
 IRUN=T                                        !Bool to run DMRG. F for post-processing
 IMEASURE=F                                    !Bool to perform measurements. T for post-processing.
 IENERGY=F                                     !Bool to get energy measures. T for post-processing.
 MH=2.000000000                                !
 LAMBDA=3.000000000E-01                        !
 DMRGTYPE=i                                    !Set the DMRG algorithm: 'i,I'=Infinite, 'f,F'=Finite. Default i
 PBCDMRG=F                                     !Set the Periodic(T) or Open(F) boundary conditions. Default F (OBC)
 LDMRG=6                                       !iDMRG steps to take=max length of the SB.
 MDMRG=20                                      !Number of states for truncation. If Edmrg>0 use as maximum retained states.
 EDMRG=0.d0                                    !Threshold energy for truncation. If Mdmrg>0 use Mdmrg as maximum retained states.
 NSWEEP=1                                      !Number of DMRG sweep to take for finite DMRG algorithm (min 1).
 MSWEEP=1                                      !!list of states for each sweep in a finite DMRG algorithm.
 ESWEEP=0.d0                                   !!list of error threshold for each sweep in a finite DMRG algorithm.
 DMRG_MODE=normal                              !Flag to set DMRG type: normal=normal, superc=superconductive, nonsu2=broken SU(2)
 QNTRUNCATION_ERROR=0.d0                       !Threshold error on the the symmetry sector RDM truncation: W_k=sum_{i\in QN(k) w_i < QNtruncation_error are excluded
 QNTRUNCATION_DIM=1                            !Threshold dimension on the symmetry sector RDM truncation: dim(QN(k)<QNtruncation_dim are excluded.
 QNDIM=2                                       !Total  conserved abelian quantum numbers to consider.
 QN_DENSITY=1.000000000,1.000000000            !Reference charge per site (all orbitals), in local-basis units
 QN_OFFSET=0.d0,0.d0                           !Length-independent total charge added after truncating L*QN_DENSITY
 NORB=2                                        !Number of impurity orbitals.
 ULOC=1.000000000,1.000000000                  !Values of the local interaction per orbital
 UST=5.000000000E-01                           !Value of the inter-orbital interaction term
 JH=2.500000000E-01                            !Hunds coupling
 JX=0.d0                                       !S-E coupling, Jxy Heisenberg
 JP=0.d0                                       !P-H coupling, Jz  Heisenberg
 HFMODE=T                                      !Flag to set the Hartree form of the interaction (n-1/2).
 DEG_EVALS_THRESHOLD=1.000000000E-01           !threshold for degenerate eigenvalues of rho
 VERBOSE=1                                     !Verbosity level: 0=almost nothing --> 5:all. Really: all
 SPARSE_H=F                                    !Sparse H*v: True = allocate sparse; False=direct product using QN decomposition
 DIRECT_H_LAZY=T                               !Direct H*v: True = lazily filter QN operator blocks during MVP; False=cache filtered operator blocks
 HXV_DETAIL_PROFILE=F                          !Profile lazy MPI H*v filtering, local contractions and MPI transposes
 WF_PREDICT_DIAG=F                             !Diagnose a trial wavefunction; do not pass it to ARPACK
 WF_PREDICT_SEED=F                             !Experimental correlated OBC ARPACK seed
 LANC_CHECK_RESIDUAL=T                         !Measure absolute Ritz residuals after ARPACK (one extra H*v per state)
 LANC_NEIGEN=1                                 !Number of states per SB sector to be determined.
 GS_DEG_THRESHOLD=1.000000000E-10              !Absolute energy threshold for ground-state degeneracy.
 LANC_NCV_FACTOR=10                            !Set the size of the Arpack block (Ncv=lanc_ncv_factor*Neigen+lanc_ncv_add)
 LANC_NCV_ADD=0                                !Set the size of the Arpack block (Ncv=lanc_ncv_factor*Neigen+lanc_ncv_add)
 LANC_NITER=1024                               !Number of Lanczos iteration in spectrum determination.
 LANC_TOLERANCE=1.000000000E-10                !Tolerance for the Lanczos iterations as used in Arpack and plain lanczos.
 LANC_DIM_THRESHOLD=128                        !Dimension threshold for Lapack use.
 SAVE_BLOCK=F                                  !Logical flag to trigger block storage. DEBUG enforces T. Default: T
 SAVE_ALL_BLOCKS=F                             !Logical flag to save all blocks (T) or just the last (F). DEBUG enforces T. Default: F
 BLOCK_UMAT_CACHE=F                            !Logical flag to keep all rotation matrices in the block memory. Default=F to save memory.
 SAVE_UMAT=F                                   !Logical flag to save rotation matrices to file. Default=T
 SAVE_MEASURE_STATE=F                          !Logical flag to save SuperBlock state for post-processing measures. Default=T
 BLOCK_FILE=block                              !Name prefix of the stored block file, used to restart DMRG.
 UMAT_FILE=umat                                !Name suffix of the stored rotation matrices, used to measure in DMRG.
 LAMBDAQ_FILE=lambdaQ                          !Name of the prefix of the stored symmetry resolved RDMs eigenvalues file.
 MEASURE_FILE=measure                          !Name prefix of the stored SuperBlock measurement state.
 LOGFILE=6                                     !LOG unit.
